# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# secrets
/sandbox/id_rsa
/sandbox/id_rsa.pub

# build
.turbo

# Runner runtime state — apps/api/data is where the Go Runner materializes
# and executes each deploy (Terraform/Ansible/K8s files, .terraform provider
# binaries, terraform.tfstate, the SQLite dev DB). All of it is generated at
# runtime, can be large (downloaded Terraform providers), and can contain
# deploy-time secrets in tfstate — never commit it.
/apps/api/data/
